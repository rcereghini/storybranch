# Local server credentials only. Never use a VITE_ prefix for private credentials.
STORYBRANCH_MODE=firebase
# Comma-separated Firebase UIDs allowed to publish during creator alpha.
STORYBRANCH_PUBLISHER_UIDS=
GOOGLE_APPLICATION_CREDENTIALS=C:/GameDev/storybranch/.secrets/firebase-admin.json
# Netlify: put the full service-account JSON in FIREBASE_SERVICE_ACCOUNT_JSON
# using its secret environment settings, scoped to Functions. Do not paste it here.
