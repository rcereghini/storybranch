# Storybranch server environment. Every value here is server-only: never use a
# VITE_ prefix (VITE_ variables are built into the public browser bundle). The
# browser's Firebase web config is public and lives in fixtures/firebase-config.ts.
#
# Local: copy to .env.local (ignored by Git), then `pnpm dev` / `pnpm seed:firebase`.
# `pnpm dev:emulator` ignores these and uses local emulators instead.
# Vercel: set the "Hosted" values in the dashboard, not in a file.

# ── Both local and hosted ────────────────────────────────────────────────────

# Backend mode. Defaults to firebase (shared project storybranch-f77a3).
STORYBRANCH_MODE=firebase

# Comma-separated Firebase Authentication UIDs allowed to publish during the
# creator alpha. Studio shows your UID when publishing is unavailable.
# UIDs, not email addresses.
STORYBRANCH_PUBLISHER_UIDS=

# ── Local only ───────────────────────────────────────────────────────────────

# Service-account key for storybranch-f77a3 (Firebase console > Project settings >
# Service accounts), saved as .secrets/firebase-admin.json (ignored by Git).
# Relative to the repo root, so it works in any checkout.
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/firebase-admin.json

# ── Hosted only (Vercel dashboard, marked Sensitive) ─────────────────────────

# The entire service-account JSON, pasted as-is. Takes precedence over
# GOOGLE_APPLICATION_CREDENTIALS. Never commit it or paste it into this file.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel only: makes Vercel install with the pnpm version in package.json
# (packageManager) instead of its default pnpm 9.
# ENABLE_EXPERIMENTAL_COREPACK=1

# ── Never set these here ─────────────────────────────────────────────────────
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST: mixing live and emulator
# settings fails closed. Use `pnpm dev:emulator` for local data.
