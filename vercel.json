{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist",
  "framework": null,
  "functions": { "api/index.js": { "maxDuration": 300 } },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://storybranch-f77a3.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://storybranch-f77a3.firebaseapp.com/__/firebase/:path*"
    },
    { "source": "/api/:path*", "destination": "/api" },
    {
      "source": "/s/:story/ending/:page",
      "destination": "/s/:story/ending/:page/index.html"
    },
    { "source": "/s/:story", "destination": "/s/:story/index.html" },
    {
      "source": "/s/glass-harbor/:path*",
      "destination": "/s/glass-harbor/index.html"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
