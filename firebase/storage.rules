rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The clip record the API created before the upload (users/{uid}/clips).
    function clip(uid, clipId) {
      return firestore.get(/databases/(default)/documents/users/$(uid)/clips/$(clipId)).data;
    }
    // A creator may upload a clip only once, into a pending clip record the
    // API created for them, with exactly the declared size and type. Nobody
    // reads through rules: playback uses download tokens the API issues.
    match /users/{uid}/clips/{clipId} {
      allow create: if request.auth != null
        && resource == null
        && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/(mp4|webm)')
        && clip(uid, clipId).status == 'pending'
        && clip(uid, clipId).bytes == request.resource.size
        && clip(uid, clipId).contentType == request.resource.contentType;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
