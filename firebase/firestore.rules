rules_version = '2';
// The app reads and writes through its API with the Admin SDK, which bypasses
// these rules. Clients may only read the public catalogue and their own
// records under users/{uid}; nobody writes directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /catalogue/{storyId} {
      allow read: if true;
    }
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow write: if false;
    }
  }
}
