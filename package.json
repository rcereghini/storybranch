{
  "name": "storybranch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch scripts/dev.ts",
    "dev:emulator": "tsx watch scripts/dev-emulator.ts",
    "seed:firebase": "tsx scripts/firebase-live.ts",
    "migrate:layout": "tsx scripts/migrate-live.ts",
    "features": "tsx scripts/features.ts",
    "build": "vite build && tsx scripts/metadata.ts",
    "build:vercel": "pnpm build && vite build --config vite.api.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/d20.test.ts tests/transition-timing.test.ts tests/player-runtime.test.ts tests/command.test.ts tests/analytics.test.ts tests/usage.test.ts tests/email.test.ts tests/settings.test.ts tests/domain.test.ts tests/story-naming.test.ts tests/foundation.test.ts tests/api-client.test.ts tests/firebase-config.test.ts tests/authoring.test.ts tests/dashboard.test.ts tests/share-documents.test.ts tests/uploads.test.ts tests/quiz.test.ts tests/story-node-library.test.ts tests/story-graph.test.ts tests/generation.test.ts tests/copilot.test.ts tests/comic.test.ts tests/comic-drawing.test.ts",
    "test:graph": "tsx scripts/story-graph-check.ts",
    "test:studio": "tsx scripts/studio-check.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "test:auth": "tsx scripts/auth-check.ts",
    "test:audio": "tsx scripts/audio-check.ts",
    "media": "tsx scripts/generate-media.ts",
    "media:portrait": "tsx scripts/generate-portrait.ts",
    "media:audio": "tsx scripts/generate-audio-media.ts",
    "media:scenes": "tsx scripts/generate-scene-media.ts",
    "test:media": "tsx scripts/media-check.ts",
    "test:scenes": "tsx scripts/scene-media-check.ts",
    "test:story-nodes": "tsx scripts/story-nodes-check.ts",
    "test:quiz": "tsx scripts/quiz-check.ts",
    "test:video-story-nodes": "tsx scripts/video-story-nodes-check.ts",
    "test:transitions": "tsx scripts/transition-check.ts",
    "phone:emulators": "tsx scripts/phone.ts emulators",
    "phone:seed": "tsx scripts/phone.ts seed",
    "phone:build": "tsx scripts/phone.ts build",
    "phone:serve": "tsx scripts/phone.ts serve",
    "test:phone": "tsx scripts/phone-preview-check.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "emulators": "tsx scripts/emulators.ts",
    "seed": "tsx scripts/seed.ts",
    "format": "prettier --write apps/web/src packages services fixtures scripts tests *.json *config.ts",
    "test:assets": "tsx scripts/assets-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@vercel/analytics": "2.0.1",
    "firebase": "12.4.0",
    "firebase-admin": "13.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.186.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.186.0",
    "firebase-tools": "14.19.1",
    "playwright": "1.56.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.25.0"
}
